<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- TODO: why do we need this? the Tasker SDK seems to fail to use proper modern android methods -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- TASKER PLUGIN -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    
    <!-- NOTIFICATION INTERCEPTION -->
    <uses-permission android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" />

    <application
        android:name="online.avogadro.opencv4tasker.app.OpenCV4TaskerApplication"
        android:requestLegacyExternalStorage="true"
        android:allowBackup="true"
        android:icon="@mipmap/ai_image_analyzer"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ai_image_analyzer_round"
        android:theme="@style/AppTheme">
        <!-- Native libraries required by LiteRT-LM GPU backend -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <activity android:name="online.avogadro.opencv4tasker.MainActivity"
            android:exported="false" />
        <activity android:name="online.avogadro.opencv4tasker.ConfigActivity"
            android:exported="false" />
        <activity
            android:name="online.avogadro.opencv4tasker.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tasker plugin entry points -->
        <activity
            android:name="online.avogadro.opencv4tasker.tasker.ActivityConfigDetectHumansAction"
            android:exported="true"
            android:icon="@mipmap/human_detection"
            android:label="Detect humans in the picture">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.EDIT_SETTING" />
            </intent-filter>
        </activity>
        
        <activity
            android:name="online.avogadro.opencv4tasker.tasker.ActivityConfigAnalyzeImageAction"
            android:exported="true"
            android:icon="@mipmap/ai_image_analyzer"
            android:label="Analyze image with AI">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.EDIT_SETTING" />
            </intent-filter>
        </activity>

        <activity
            android:name="online.avogadro.opencv4tasker.tasker.ActivityConfigCancelNotificationAction"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_delete"
            android:label="Cancel Notification">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.EDIT_SETTING" />
            </intent-filter>
        </activity>

        <!-- Notification Listener Service -->
        <service android:name="online.avogadro.opencv4tasker.notification.NotificationInterceptorService"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Tasker plugin entry point for notification event -->
        <activity
            android:name="online.avogadro.opencv4tasker.tasker.ActivityConfigNotificationInterceptedEvent"
            android:exported="true"
            android:icon="@mipmap/ai_image_analyzer"
            android:label="Notification Intercepted">
            <intent-filter>
                <action android:name="net.dinglisch.android.tasker.ACTION_EDIT_EVENT" />
            </intent-filter>
        </activity>

    </application>

</manifest>
